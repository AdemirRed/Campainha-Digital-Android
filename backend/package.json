{
  "name": "smart-doorbell-backend",
  "version": "1.0.0",
  "description": "Backend API para campainha inteligente",
  "main": "dist/backend/src/bootstrap.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/post-build.mjs",
    "start": "node dist/backend/src/bootstrap.js",
    "type-check": "tsc --noEmit",
    "migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "sql.js": "^1.10.3",
    "web-push": "^3.6.7",
    "winston": "^3.11.0",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "canvas": "^3.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
