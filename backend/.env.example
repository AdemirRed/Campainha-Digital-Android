# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/doorbell.db

# Security
API_TOKEN=your-secret-token-here-change-this
SESSION_SECRET=another-secret-change-this

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Storage
STORAGE_PATH=./data/storage
VIDEOS_PATH=./data/storage/videos
PHOTOS_PATH=./data/storage/photos
THUMBNAILS_PATH=./data/storage/thumbnails

# Detection (stub settings for MVP)
DETECTION_ENABLED=false
DETECTION_INTERVAL=5000

# OpenAI is the primary assistant. Keep this key only on the backend;
# never put it in the Android app, frontend or version control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Ollama Cloud is the automatic backup when OpenAI is unavailable or out of credits.
# For a local Ollama server, set OLLAMA_BASE_URL=http://127.0.0.1:11434
# and leave OLLAMA_API_KEY empty.
OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=kimi-k2.7-code:cloud

# Web Push (rings resident devices even with the site closed). Generate with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# WebRTC call signaling (STUN only - LAN-only calls for now, no TURN relay)
STUN_SERVER=stun:stun.l.google.com:19302
