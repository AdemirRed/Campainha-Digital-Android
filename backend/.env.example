# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/doorbell.db

# Security
API_TOKEN=your-secret-token-here-change-this
SESSION_SECRET=another-secret-change-this

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Storage
STORAGE_PATH=./data/storage
VIDEOS_PATH=./data/storage/videos
PHOTOS_PATH=./data/storage/photos
THUMBNAILS_PATH=./data/storage/thumbnails

# Detection (stub settings for MVP)
DETECTION_ENABLED=false
DETECTION_INTERVAL=5000

# Ollama Cloud (virtual assistant that talks to unrecognized visitors and
# summarizes activity to residents)
OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=kimi-k2.7-code:cloud

# Future: Firebase Cloud Messaging (Fase 4)
# FCM_SERVER_KEY=
# FCM_SENDER_ID=

# Future: WebRTC (Fase 3)
# STUN_SERVER=stun:stun.l.google.com:19302
# TURN_SERVER=
# TURN_USERNAME=
# TURN_PASSWORD=
